# Nebius Token Factory credentials. Use the base URL shown in your dashboard.
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model IDs per role. Confirm against `python scripts/check_models.py`.
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/nemotron-3-super-120b-a12b
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b

# Agent limits
MAX_FIX_ATTEMPTS=5

# Optional: token budget per call. Nemotron reasoning traces count against it,
# so keep it generous. On an empty answer cut off by length, it doubles up to the cap.
# LLM_MAX_TOKENS=16384
# LLM_MAX_TOKENS_CAP=65536
# LLM_TIMEOUT_SECONDS=600
