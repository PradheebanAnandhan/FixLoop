# --- Model provider ---------------------------------------------------------
# Any OpenAI-compatible API works. Pick one with LLM_PROVIDER:
#   nebius      Nebius Token Factory (default; required for the hackathon submission)
#   nvidia      NVIDIA API Catalog (build.nvidia.com) - free developer access, serves Nemotron
#   groq        Groq - free tier, fast, but no Nemotron models and tight per-minute limits
#   openrouter  OpenRouter - some free models
#   custom      any other endpoint: set LLM_BASE_URL and LLM_API_KEY
LLM_PROVIDER=nebius

# Nebius Token Factory (use the base URL shown in your dashboard)
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Keys for the other providers (only the one matching LLM_PROVIDER is read)
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=            # overrides the provider-specific key
# LLM_BASE_URL=           # overrides the provider's default URL

# Model IDs per role. Always confirm with `python scripts/check_models.py`,
# which lists the models your key can use.
#   Nebius Token Factory (Nemotron):
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/nemotron-3-super-120b-a12b
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
#   Example for Groq (IDs change over time; check the listing):
# MODEL_FAST=llama-3.1-8b-instant
# MODEL_MID=llama-3.3-70b-versatile
# MODEL_REASONING=openai/gpt-oss-120b

# Free-tier tuning (the provider presets set sensible defaults)
# LLM_CONTEXT_CHARS=20000        # source code included per prompt; lower it on 413 / rate-limit errors
# LLM_MIN_INTERVAL_SECONDS=2     # pause between requests
# LLM_MAX_RETRIES=6              # retries on 429 / 5xx (Retry-After is honored)

# Agent limits
MAX_FIX_ATTEMPTS=5
# MAX_REPRO_ATTEMPTS=3

# Held-out edge-case tests written by Nano and hidden from the fixer:
#   report = run and record them in the evidence (default)
#   gate   = the patch must also pass them
#   off    = don't write them
# HELDOUT_MODE=report

# Optional: USD per 1M input,output tokens, for cost reporting (check your Token Factory pricing)
# MODEL_FAST_PRICE=<input>,<output>
# MODEL_MID_PRICE=<input>,<output>
# MODEL_REASONING_PRICE=<input>,<output>

# Optional: GitHub token (avoids API rate limits when fetching issues)
# GITHUB_TOKEN=
# Sandbox base image (Python version the target repo is tested with)
# SANDBOX_BASE_IMAGE=python:3.12-slim
# RUNS_DIR=runs

# Optional: token budget per call. Nemotron reasoning traces count against it,
# so keep it generous. On an empty answer cut off by length, it doubles up to the cap.
# LLM_MAX_TOKENS=16384
# LLM_MAX_TOKENS_CAP=65536
# LLM_TIMEOUT_SECONDS=600

# Verifier limits (deterministic accept/reject; see verifier/)
# VERIFIER_MAX_PATCH_LINES=200
# VERIFIER_MAX_PATCH_FILES=6
# VERIFIER_TARGETED_TIMEOUT=300
# VERIFIER_SUITE_TIMEOUT=1200

# Optional: extra CA bundle for pip during sandbox image builds, only needed
# behind a TLS-intercepting proxy. Mounted as a build secret, not stored in the image.
# FIXLOOP_BUILD_CA_BUNDLE=/path/to/ca-bundle.crt
